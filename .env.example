# BravoCryptoCoin Environment Configuration

# Private Keys and Accounts
PRIVATE_KEY=your_private_key_here

# Flare Network RPC Endpoints
SONGBIRD_RPC_URL=https://songbird.towolabs.com/rpc
FLARE_RPC_URL=https://flare.towolabs.com/rpc

# API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Token Configuration
TOTAL_SUPPLY=77000000
STARTING_PRICE_EUR=5

# Phase 1 Deployment Addresses (Songbird & Flare)
