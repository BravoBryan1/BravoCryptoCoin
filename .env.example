FLARE_MAINNET_POOL_ADDRESS=0x0000000000000000000000000000000000000000
TEAM_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Phase 2 Deployment Addresses
DELEGATION_POOL_ADDRESS=0x0000000000000000000000000000000000000000
FARMING_POOL_ADDRESS=0x0000000000000000000000000000000000000000
CHARITY_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Phase Unlock Dates (Unix timestamps)
PHASE_1_SONGBIRD_DATE=1726272000      # 14/09/2026
PHASE_1_MAINNET_DATE=1742169600       # 14/03/2027
PHASE_2_RELEASE_DATE=1743379200       # 02/04/2027
PHASE_3_UNLOCK_DATE=2378188800        # 29/06/2045

# Real-World Asset Integration
GOLD_RESERVE_VALUE=130000              # €130,000 in EUR
PAXG_STABLECOIN_ADDRESS=0x0000000000000000000000000000000000000000
REAL_ESTATE_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# Node and Network Settings
NODE_ENV=development
NETWORK=songbird
GAS_PRICE=25000000000                  # 25 gwei
GAS_LIMIT=8000000
